# Copy to .env for local overrides. Never commit .env.
# This project needs NO secrets: no API keys, no tokens, no passwords.
# Every value is optional; unset values fall back to agent.config.json, then to safe defaults.

# --- Minecraft ---
# Used by the READ-ONLY live client (`pnpm cli observe --live`, `pnpm cli once --live`).
# Only loopback / private LAN / Tailscale (100.64.0.0/10) addresses are accepted.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=gtnh_agent
# offline = a private server you control in offline mode. Microsoft auth tokens are never stored in this repo.
MC_AUTH=offline
MC_VERSION=1.7.10
# Hostnames (not IPs) you have verified point at YOUR private server, comma-separated, e.g. msi
MC_ALLOWED_HOSTNAMES=
# Must be exactly "true" before any live client opens a socket.
MC_ENABLE_LIVE_CONNECTION=false
# Text that must appear in the server's MOTD before the client logs in (e.g. gtnh-agent-test).
# Live connections are refused while this is unset.
MC_SERVER_MARKER=
# Send idle "still here" packets at the player's position so the server reports
# health/food. Set false for a fully passive client (it then cannot walk either).
MC_PRESENCE_TICKS=true
# OWNERS (empty by default: nobody, and no chat is ever a command): players whose whispers to
# the bot, and public chat starting with ! or # or the bot's name, are commands (!come, !follow,
# !goto x y z, !get 20 logs, !stop, !help; README "Commanding the bot"). Exact, case-sensitive
# names, comma-separated. The bot whispers its replies to them, and never chats otherwise.
# MC_OWNERS=DankAxon
# WALKING (world-changing; off by default). The client walks only when this is "true" AND
# a fence is set: whole blocks at the player's feet level, one level only (same y), at most
# 64 x 64. Build a test pen first: node scripts/test-server-admin.ts pen show / pen build.
MC_ENABLE_MOVEMENT=false
# MC_MOVEMENT_FENCE_MIN=-9,200,-12
# MC_MOVEMENT_FENCE_MAX=-1,200,-4
# Where walks and digs may go: fixed (default: the fence above, nothing else) or follow (a play
# area centred on the player, 64 x 64 blocks and 32 levels, that moves with it; the fence is then
# not used). EXPLORE needs follow. In follow mode the SAFETY_BOUNDARY_MIN/MAX below is the
# EXPLORATION AREA: the play area never leaves it, so set it to the area you allow (a few hundred
# blocks around spawn; at most 2048 per side in this mode). Exploring happens only in daylight.
# MC_MOVEMENT_MODE=follow
# CHESTS (world-changing; off by default): OPEN_CONTAINER / WITHDRAW_ITEM / DEPOSIT_ITEM on
# the vanilla chests listed in agent.config.json (minecraft.containers.chests).
MC_ENABLE_CONTAINERS=false
# DIGGING (world-changing; off by default): DIG_BLOCK breaks one allowlisted natural block
# (logs, leaves, dirt, grass, sand, gravel, clay) with an empty hand, only inside the fence's
# columns from its level up to minecraft.digging.maxHeightAboveFence (4) above it. Needs the fence.
MC_ENABLE_DIGGING=false
# CRAFTING (world-changing: consumes items; off by default): CRAFT_ITEM in the 2x2 grid, and at
# the crafting tables listed in agent.config.json (minecraft.crafting.tables) for 3x3 recipes.
MC_ENABLE_CRAFTING=false
# PLACING (world-changing; off by default): PLACE_BLOCK puts one allowlisted plain block the
# player carries (dirt, cobblestone, sand, gravel, sandstone, planks, logs) into an empty cell,
# only inside the fence's columns from its level up to minecraft.placing.maxHeightAboveFence (4)
# above it, and never during danger. Needs the fence.
MC_ENABLE_PLACING=false
# INTERACTING WITH BLOCKS (world-changing: moves items into and out of furnaces; off by default):
# INTERACT_BLOCK / SMELT / TAKE_OUTPUT on blocks with an interaction profile (furnaces, crafting
# tables, chests, Iron Chests chests...; src/domain/interactions.ts). Found chests then also work
# with the chest actions (with MC_ENABLE_CONTAINERS=true).
MC_ENABLE_INTERACT=false
# Blocks WITHOUT a profile the agent may LOOK at (open, record the window, close; nothing inside
# is ever clicked): exact registry names or whole mods, comma-separated.
# MC_INTERACT_OBSERVE_ONLY=appliedenergistics2:*
# COMBAT (world-changing: kills mobs; off by default): ATTACK_ENTITY strikes one listed hostile
# (or a grown, unowned cow/pig/sheep/chicken for a task) without moving, and System 1 may decide
# DEFEND. Never players, villagers, pets, creepers or unidentified mobs. Needs the fence.
# Thresholds: safety.combat in agent.config.json.
MC_ENABLE_COMBAT=false
# EATING (off by default: it uses up an item): EAT_FOOD takes an approved food
# (safety.approvedFoods) into the hand and uses it until the server has eaten it; without it,
# System 1 never decides EAT.
MC_ENABLE_EATING=false
# QUEST BOOK (off by default): the play loop's quest-book clicks in Better Questing, for the Age 0
# quests the server lists as active: SUBMIT_QUEST (hands in the items of consume tasks, never a
# protected item), CHECK_QUEST_BOX and CLAIM_QUEST_REWARD. Reading the quest book needs no switch.
MC_ENABLE_QUEST_BOOK=false
# While this file exists nothing walks, uses chests, crafts, digs, places, opens blocks, fights or clicks in the quest book (pnpm cli halt / pnpm cli unhalt).
# MC_MOVEMENT_STOP_FILE=./data/STOP
# HOW WALKS MOVE over terrain (the pathfinder; like Baritone's allowBreak, allowPlace, allowParkour
# and allowSprint). Each break and place is checked like DIG_BLOCK's and PLACE_BLOCK's.
# Break natural blocks in the way (with MC_ENABLE_DIGGING): the dig allowlist with the best tool
# carried, stone only with a pickaxe that harvests it; never ores, a player's build, or a block
# within 4 blocks of another player.
# MC_PATH_ALLOW_BREAK=true
# Pillar up and bridge gaps (with MC_ENABLE_PLACING): dirt, cobblestone or netherrack carried,
# never a protected item, never within 3 blocks of another player.
# MC_PATH_ALLOW_PLACE=true
# Running jumps over gaps of 1-2 blocks (3 sprinting), only over gaps that are safe to fall into...
# MC_PATH_ALLOW_PARKOUR=true
# ...unless this is true too.
# MC_PATH_PARKOUR_DEEP_GAPS=false
# Sprint on long walks with food above 10 (off: HungerOverhaul makes sprinting cost food).
# MC_PATH_ALLOW_SPRINT=false
# Wade through calm one-deep water, and drop into it from a height that does not hurt.
# MC_PATH_ALLOW_WATER=false
# Walk through doorways: open a wooden door or fence gate in the way, close it again behind.
# MC_PATH_ALLOW_DOORS=true
# Climb ladders (up, down, onto and off them; never vines).
# MC_PATH_ALLOW_CLIMB=true
# Dirt never placed on a walk: kept for the night shelter's roof.
# MC_PATH_THROWAWAY_RESERVE=4

# --- Test-server operator tool (scripts/test-server-admin.ts; not used by the agent) ---
# The server folder; RCON port and password are read from its server.properties.
# TEST_SERVER_DIR=C:\path\to\gtnh-test-server
# The movement pen: centre block at the player's feet level, and interior half-width.
# TEST_PEN_CENTER=-5,200,-8
# TEST_PEN_RADIUS=4

# --- Local models (Ollama); see docs/local-llm-integration.md ---
# Unset, today's behaviour stays: the deterministic router decides, the mock planner plans.
# Models only PROPOSE: every decision and plan step is validated and executed by code.
# Planner: mock | none | ollama
# AGENT_PLANNER=ollama
# System 1 decisions: deterministic | ollama (always wrapped by SafetyFirstDecisionProvider)
# AGENT_DECISIONS=ollama
# When the System 1 model is asked: decision-points (default: a session's first cycle, a failed
# action, a plan that ended or none to continue, a new condition such as a mob, the evening or a
# nearly full inventory; otherwise the router's decision continues the open plan at once) or
# every-cycle (every cycle the router's safety rules do not decide alone).
# AGENT_DECISION_CADENCE=decision-points
# Only loopback / private LAN / Tailscale addresses (or OLLAMA_ALLOWED_HOSTNAMES) are accepted.
# OLLAMA_URL=http://127.0.0.1:11434
# Hostnames (not IPs) you have verified point at YOUR model server, e.g. msi
# OLLAMA_ALLOWED_HOSTNAMES=
# OLLAMA_PLANNER_MODEL=qwen3:14b
# OLLAMA_DECISION_MODEL=qwen3:14b   (the default qwen2.5:0.5b only proves the plumbing)
# Per request, including loading the model. Timeouts pause (decisions) or escalate (plans).
# OLLAMA_TIMEOUT_MS=120000
# Owners' commands in natural language ("bring me 20 logs"): none (default: only the command
# form, !come or come, is understood) | ollama (a local model turns the text into one of the
# same fixed commands, which code then checks like the command form).
# AGENT_COMMANDS=ollama
# OLLAMA_COMMAND_MODEL=qwen3:14b

# --- Storage ---
AGENT_DB_PATH=./data/agent.sqlite
# Optional explicit JSON config file (default: ./agent.config.json if present)
# AGENT_CONFIG_FILE=./agent.config.json

# --- Safety overrides (see agent.config.example.json for all options) ---
# The work area. With MC_MOVEMENT_MODE=follow it is also the exploration area (see above).
# SAFETY_BOUNDARY_MIN=-256,0,-256
# SAFETY_BOUNDARY_MAX=256,255,256
# SAFETY_ALLOWED_DIMENSIONS=overworld
# SAFETY_MIN_HEALTH=10
# SAFETY_HUNGER_EAT_THRESHOLD=14
# SAFETY_MIN_HUNGER=6
# SAFETY_MAX_STATE_AGE_MS=5000
# SAFETY_HAZARD_RADIUS=6
# Added to (never replacing) the config file's protected items:
# SAFETY_PROTECTED_ITEMS=minecraft:diamond,minecraft:nether_star
